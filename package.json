{
  "name": "emberling",
  "productName": "Emberling",
  "version": "0.75.9",
  "description": "Emberling desktop agent — rebuilt from REA findings, powered by free API providers",
  "main": "electron/main.js",
  "private": true,
  "author": "Piyush Anand",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "icons": "electron scripts/make-icons.cjs",
    "test": "node scripts/launch-and-test.mjs && node scripts/real-click-test.mjs && node scripts/menu-items-test.mjs",
    "dist": "npm run build && electron-builder --win nsis portable",
    "pack": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.piyyushanand.emberling",
    "productName": "Emberling",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "renderer-build/**",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "icon": "build/icon.ico",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Emberling",
      "artifactName": "Emberling-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Emberling-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "PiyushAnand2006",
      "repo": "EmberLing"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "imapflow": "^1.0.191",
    "mammoth": "^1.13.0",
    "mermaid": "^12.2.0",
    "nodemailer": "^7.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
